{
  "rules": {
    "profiles": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'publicId', 'createdAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "publicId": {
          ".validate": "newData.isString() && newData.val().length <= 15"
        },
        "about": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "lastActive": {
          ".validate": "newData.isNumber()"
        },
        "email": {
          ".validate": "false"
        }
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "(auth != null && auth.uid === $uid) || (!data.exists() && newData.child('isGuest').val() === true) || (data.child('isGuest').val() === true)",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'isOnline', 'lastSeen'])"
      }
    },
    "matchmaking": {
      "queue": {
        ".read": true,
        "$entryKey": {
          ".write": "true",
          ".validate": "newData.hasChildren(['queueKey', 'uid', 'displayName', 'timeControlId', 'createdAt'])"
        }
      }
    },
    "invitations": {
      ".read": true,
      "$invitationId": {
        ".write": "true",
        ".validate": "newData.hasChildren(['id', 'senderUid', 'senderName', 'recipientUid', 'timeControlId', 'status', 'createdAt'])"
      }
    },
    "userInvitations": {
      "$recipientUid": {
        ".read": "auth != null ? auth.uid === $recipientUid : true",
        "$invitationId": {
          ".write": "true"
        }
      }
    },
    "rooms": {
      ".read": true,
      "$roomId": {
        ".write": "true",
        ".validate": "newData.hasChildren(['roomId', 'roomCode', 'hostUid', 'status', 'timeControlId', 'createdAt'])",
        "roomId": {
          ".validate": "newData.isString() && newData.val() === $roomId"
        },
        "roomCode": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 10"
        },
        "status": {
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'ended'"
        }
      }
    },
    "roomCodes": {
      ".read": true,
      "$code": {
        ".write": "true",
        ".validate": "newData.isString()"
      }
    },
    "chat": {
      "$roomId": {
        ".read": true,
        "$messageId": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['senderUid', 'senderName', 'text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 200"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null",
        "$friendUid": {
          ".validate": "newData.hasChildren(['uid', 'displayName', 'since'])"
        }
      }
    },
    "friendRequests": {
      "$recipientUid": {
        ".read": "auth != null && auth.uid === $recipientUid",
        "$senderUid": {
          ".write": "auth != null && (auth.uid === $senderUid || auth.uid === $recipientUid)",
          ".validate": "newData.hasChildren(['fromUid', 'fromName', 'timestamp'])"
        }
      }
    }
  }
}
